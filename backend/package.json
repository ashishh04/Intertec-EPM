{
  "name": "epm-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EPM BFF — normalizes OpenProject into EPM domain models for the EPM frontend",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "npm run types:check && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "npm run types:check && tsc --noEmit",
    "types:check": "tsx src/scripts/sync-types.ts",
    "types:sync": "tsx src/scripts/sync-types.ts --write",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "probe": "tsx --env-file-if-exists=.env src/scripts/probe-openproject.ts",
    "test:authz": "tsx --env-file-if-exists=.env src/scripts/authz-test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/client": "^6.2.1",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
