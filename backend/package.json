{
  "name": "epm-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EPM BFF \u2014 normalizes OpenProject into EPM domain models for the EPM frontend",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "npm run types:check && tsc -p tsconfig.json",
    "build:image": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "npm run types:check && tsc --noEmit",
    "types:check": "tsx src/scripts/sync-types.ts",
    "types:sync": "tsx src/scripts/sync-types.ts --write",
    "i18n:check": "tsx src/scripts/i18n-check.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "probe": "tsx --env-file-if-exists=.env src/scripts/probe-openproject.ts",
    "test:authz": "tsx --env-file-if-exists=.env src/scripts/authz-test.ts",
    "analytics": "tsx --env-file-if-exists=.env src/scripts/analytics.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.6",
    "@anthropic-ai/sdk": "0.126.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@prisma/client": "^6.2.1",
    "@types/nodemailer": "^8.0.2",
    "bidi-js": "^1.1.0",
    "fastify": "^5.12.5",
    "fontkit": "^2.0.4",
    "nodemailer": "^10.0.10",
    "prisma": "^7.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.10.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
