# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- OpenProject (server-side only; never exposed to the browser) -------------
OPENPROJECT_BASE_URL=http://localhost:8080
# Generate under Avatar → My account → Access tokens → API. The API is not
# reachable with a login/password — only an API token authenticates, and it is
# sent as HTTP Basic with the literal username "apikey".
OPENPROJECT_API_KEY=
OPENPROJECT_TIMEOUT_MS=20000

# --- OAuth2 (EPM signs users in as themselves, not as the API key) -----------
# Register under Administration -> Authentication -> OAuth applications
# (confidential, scope api_v3). Users never see OpenProject: they sign in on
# EPM's form and the backend exchanges their credentials for a token.
# Requires backend/openproject/zzz_epm_password_grant.rb on the instance.
OPENPROJECT_OAUTH_CLIENT_ID=
OPENPROJECT_OAUTH_CLIENT_SECRET=

# --- EPM BFF ----------------------------------------------------------------
NODE_ENV=development
PORT=8000
API_PREFIX=/api
# Comma-separated. Must be explicit origins — the frontend sends credentials,
# so a wildcard is not permitted by the browser.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info

# Signs the HTTP-only session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Postgres -----------------------------------------------------------------
DATABASE_URL=postgresql://epm:epm@localhost:5433/epm?schema=public

# Comma-separated OpenProject user ids that hold EPM-owned administrative
# permissions (departments). No upstream capability implies these.
EPM_ADMIN_USER_IDS=

# Periodic analytics capture. Off by default: a scheduler that starts itself
# would write to the metric table during every test run and every dev restart.
# Set to "true" in an environment that should record daily history.
EPM_ANALYTICS_SNAPSHOT_ENABLED=
# How often to capture, in minutes. Default 1440 (daily), minimum 5. A snapshot
# is keyed to a UTC day, so a shorter interval refreshes today's rows rather
# than adding more history.
EPM_ANALYTICS_SNAPSHOT_INTERVAL_MINUTES=

# --- Email (Resend) ------------------------------------------------------------
# Where the frontend is served, for links in email. Never taken from a request.
APP_BASE_URL=http://localhost:5173
# From https://resend.com/api-keys. Leave empty to log email instead of sending.
RESEND_API_KEY=
# Must be on a domain verified in Resend (SPF, DKIM, DMARC set by IT).
#
# For local testing without a verified domain, use Resend's shared sender:
#   EMAIL_FROM=EPM <onboarding@resend.dev>
# Mail from an unverified domain is rejected with a 403 the worker treats as
# permanent, so it fails once and never retries — which looks like "email is
# broken" rather than "the sender is not verified". Not for production: the
# shared sender is rate-limited and its reputation is not yours.
EMAIL_FROM=EPM <epm@example.com>
# --- SMTP (alternative to Resend) ---------------------------------------
# Any mailbox the organisation already owns. Takes precedence over Resend when
# host, user and password are all set; a partly-filled block is ignored, so the
# app keeps sending through Resend until the mailbox is complete.
#
# Use this instead of Resend when no sending domain has been verified in DNS:
# Resend refuses every recipient except its own account owner until it has been,
# whereas a real mailbox will send to anyone.
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=notifications.example@gmail.com
#   SMTP_PASSWORD=<16-character App Password, not the account password>
#   EMAIL_FROM=EPM <notifications.example@gmail.com>
# The App Password comes from https://myaccount.google.com/apppasswords and
# needs 2-Step Verification switched on first. Gmail rewrites a From that is
# not the authenticated mailbox or one of its verified aliases, so EMAIL_FROM
# should match SMTP_USER. A free Gmail account sends about 500 messages a day;
# Workspace allows 2000.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Implicit TLS, as on port 465. Leave empty to follow the port.
SMTP_SECURE=

# The outbox worker sends queued mail in batches. Off by default; set "true"
# in an environment that should deliver.
EPM_EMAIL_WORKER_ENABLED=
EPM_EMAIL_WORKER_INTERVAL_SECONDS=30
# Hour of the day (UTC) the daily digest goes out.
EPM_EMAIL_DIGEST_HOUR_UTC=6
# Administration -> API and webhooks -> Webhooks: the secret entered there.
OPENPROJECT_WEBHOOK_SECRET=

# --- Time & Costs --------------------------------------------------------------
# ISO 4217 code for the currency internal hourly rates are quoted in. OpenProject
# keeps its own costs_currency in a module with no API, so this is EPM's.
EPM_CURRENCY=AED

# --- Pragnya (Claude in Amazon Bedrock) ----------------------------------------
# With the region or the model empty the assistant says it is not configured.
# The model id carries the anthropic. prefix; see the Bedrock model catalogue.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# An IAM principal allowed to call bedrock-mantle:CreateInference. Leave both
# blank when the host already has credentials — a shared profile, an assumed
# role or an instance role are all picked up automatically, and are preferable
# to a long-lived key. AWS_SESSION_TOKEN is only for temporary credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Daily deadline reminder: one email per person listing their overdue work and
# anything due within the window. Off by default.
EPM_DUE_REMINDER_ENABLED=
# Hour of the day (UTC) the sweep runs.
EPM_DUE_REMINDER_HOUR_UTC=7
# How many days ahead count as "due soon". Max 14.
EPM_DUE_REMINDER_DAYS=3
