# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- OpenProject (server-side only; never exposed to the browser) -------------
OPENPROJECT_BASE_URL=http://localhost:8080
# Generate under Avatar → My account → Access tokens → API. The API is not
# reachable with a login/password — only an API token authenticates, and it is
# sent as HTTP Basic with the literal username "apikey".
OPENPROJECT_API_KEY=
OPENPROJECT_TIMEOUT_MS=20000

# --- OAuth2 (EPM signs users in as themselves, not as the API key) -----------
# Register under Administration -> Authentication -> OAuth applications
# (confidential, scope api_v3). Users never see OpenProject: they sign in on
# EPM's form and the backend exchanges their credentials for a token.
# Requires backend/openproject/zzz_epm_password_grant.rb on the instance.
OPENPROJECT_OAUTH_CLIENT_ID=
OPENPROJECT_OAUTH_CLIENT_SECRET=

# --- EPM BFF ----------------------------------------------------------------
NODE_ENV=development
PORT=8000
API_PREFIX=/api
# Comma-separated. Must be explicit origins — the frontend sends credentials,
# so a wildcard is not permitted by the browser.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info

# Signs the HTTP-only session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Postgres -----------------------------------------------------------------
DATABASE_URL=postgresql://epm:epm@localhost:5433/epm?schema=public

# Comma-separated OpenProject user ids that hold EPM-owned administrative
# permissions (departments). No upstream capability implies these.
EPM_ADMIN_USER_IDS=

# Periodic analytics capture. Off by default: a scheduler that starts itself
# would write to the metric table during every test run and every dev restart.
# Set to "true" in an environment that should record daily history.
EPM_ANALYTICS_SNAPSHOT_ENABLED=
# How often to capture, in minutes. Default 1440 (daily), minimum 5. A snapshot
# is keyed to a UTC day, so a shorter interval refreshes today's rows rather
# than adding more history.
EPM_ANALYTICS_SNAPSHOT_INTERVAL_MINUTES=
