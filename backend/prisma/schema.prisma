// EPM BFF — EPM-owned state.
//
// OpenProject remains the system of record for projects, work packages, people
// and versions. Nothing here duplicates that. This database holds only what the
// EPM contract requires and OpenProject has no home for:
//
//   1. Attributes OpenProject cannot store (department, portfolio, capacity).
//   2. History OpenProject does not expose (metric trends, burndown series) —
//      the API can tell you today's overdue count, never last week's.
//   3. EPM's own concerns (sessions, sync bookkeeping, document metadata).
//
// Every row keys off the OpenProject id as a string, matching the EPM `ID`
// type, so a record here is always an overlay on an upstream object.

generator client {
  provider      = "prisma-client-js"
  // `native` covers a developer's own machine. The Debian target is named
  // explicitly for the image, whose runtime is node:22-slim with libssl3, so
  // that the engine that ships does not depend on detection having gone the
  // right way during the build.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Per-user attributes with no OpenProject column, and where a person sits in
/// A named stand-in for someone who does not have an account yet.
///
/// EPM's own record, not OpenProject's. Upstream has placeholder users too, but
/// creating one needs an Enterprise licence, so on a Community instance the
/// feature simply does not exist — and a planner still has to be able to say
/// "a second backend engineer, starting in March" before that person is hired.
///
/// What it can do is bounded by what EPM owns, and the boundary is real: a
/// placeholder belongs to a team and a department and carries weekly capacity,
/// so headcount that is planned but not yet filled shows up in team workload
/// and portfolio capacity. It cannot be a work package assignee — OpenProject
/// requires a principal it knows for that, which is the part the licence gates.
/// `convert` is the way out: it creates the real account and carries the team,
/// department and capacity across.
model PlaceholderPerson {
  id            String      @id @default(cuid())
  /// Unique regardless of case, enforced by a functional index on LOWER(name)
  /// in the migration. `@unique` is deliberately absent, as on Team and
  /// Department, so the plain index is not recreated alongside it.
  name          String
  /// Free text: "Backend engineer, Q2 start". What this placeholder is for.
  note          String?
  departmentId  String?
  departmentRef Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teamId        String?
  team          Team?       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  /// Weekly capacity in hours, matching UserProfile so the two sum together.
  hoursCapacity Float       @default(40)
  /// Set when the placeholder has been turned into a real account, with the
  /// OpenProject id it became. Kept rather than deleted so the planning history
  /// still resolves, and excluded from the active list.
  convertedTo   String?
  convertedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([departmentId])
  @@index([teamId])
  @@map("placeholder_people")
}

/// EPM's org structure.
///
/// This is the EPM-side employee record. It is keyed by the OpenProject user id
/// rather than an id of its own, and that column is deliberately not a foreign
/// key — the row it names lives in another system. A person with no mapping has
/// no row here at all, so every read treats a missing profile as "unmapped"
/// rather than as an error.
model UserProfile {
  openProjectId      String      @id
  /// Legacy free text, superseded by `departmentId`. Kept rather than dropped:
  /// this database never held a value, but another deployment might, and reads
  /// fall back to it until that person is mapped. Never written from now on.
  department         String?
  /// The department a person belongs to. When a team is assigned and that team
  /// has a department, this is derived from it — see `domain/employees.ts`.
  departmentId       String?
  departmentRef      Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teamId             String?
  team               Team?       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  /// Weekly capacity in hours, backing TeamMemberWorkload.hoursCapacity.
  hoursCapacity      Float       @default(40)
  /// Internal cost of an hour of this person's time, in the instance currency.
  ///
  /// EPM's own field. OpenProject keeps hourly rates in its costs module, which
  /// publishes no API v3 resource for them — there is nothing to read and
  /// nothing to write — so the Time & Costs report has no cost figure at all
  /// without this. Nullable on purpose: "not costed" is a real state, and the
  /// report says how many hours it applies to rather than treating them as free.
  hourlyRate         Float?
  /// Set when an administrator created this account with a starting password
  /// they chose. Cleared the moment the person sets their own.
  ///
  /// EPM's own flag, because the upstream API cannot express one: it has a
  /// `force_password_change` column, but both create and update accept the
  /// field and silently ignore it — verified against 15.5.1. So the gate is
  /// enforced here, where EPM owns the session.
  mustChangePassword Boolean     @default(false)
  timezone           String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([departmentId])
  @@index([teamId])
  @@map("user_profiles")
}

/// Per-project attributes, plus the inputs to computed health.
model ProjectProfile {
  openProjectId      String     @id
  /// Legacy free text, superseded by `portfolioId`. Kept rather than dropped:
  /// this database never held a value, but the project patch route accepts
  /// arbitrary strings, so another deployment might. Reads fall back to it
  /// until a project is linked. Never written from now on.
  portfolio          String?
  portfolioId        String?
  portfolioRef       Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  budgetTotal        Float?
  /// Retired: a hand-typed "spent so far" figure. Actual cost is now calculated
  /// from logged time (see `domain/costs.ts`), so nothing reads or writes this.
  /// Kept rather than dropped so a deployment's old figures are not destroyed.
  budgetUsed         Float?
  /// Retired: the unexplained pins that preceded `ProjectHealthOverride`.
  /// The migration that introduced overrides moved every pin across, with a
  /// reason saying it predates reasons. Nothing reads or writes this.
  healthOverride     Json?
  /// The planned (baseline) start and finish. EPM's own: an OpenProject
  /// project has no dates at all. Schedule variance is measured against the
  /// finish, and the budget planned to date is phased across the two.
  plannedStart       DateTime?  @db.Date
  plannedFinish      DateTime?  @db.Date
  /// The effective overall health as of the last notification evaluation.
  /// Without it a transition cannot be detected at all: health is computed per
  /// request and nothing else remembers what it was.
  /// The person accountable for the project.
  ///
  /// EPM's own field. OpenProject has no project owner: its project schema has
  /// no such attribute and the resource publishes no `responsible` link, so
  /// every project read as "Unassigned" and there was nothing to assign. An
  /// OpenProject user id, never a foreign key — people live upstream.
  ownerId            String?
  lastNotifiedHealth String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([portfolioId])
  @@map("project_profiles")
}

/// Sprints are OpenProject versions plus a goal and a committed-points baseline.
model SprintProfile {
  openProjectId   String   @id
  goal            String?
  /// Points committed at sprint start. Recomputing from today's scope would
  /// silently absorb mid-sprint scope changes and flatten the burndown.
  committedPoints Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("sprint_profiles")
}

/// One row per sprint per day — the series behind EpmSprint.burndown.
model BurndownSample {
  id              String   @id @default(cuid())
  sprintId        String
  /// Date only; one sample per sprint per day.
  sampledOn       DateTime @db.Date
  remainingPoints Float
  completedPoints Float
  createdAt       DateTime @default(now())

  @@unique([sprintId, sampledOn])
  @@index([sprintId])
  @@map("burndown_samples")
}

/// Daily counters behind DashboardMetrics.trends and ExecutiveInsights.
/// MetricTrend is a change against the previous period, which requires history.
model MetricSnapshot {
  id        String   @id @default(cuid())
  /// What the row is about: instance, user, portfolio, team or department.
  scopeType String   @default("instance")
  /// The id within that type; the empty string for `instance`, which has none.
  ///
  /// Not nullable, and that is load-bearing: Postgres treats NULLs as distinct
  /// in a unique index, so a nullable scopeId would let the same instance-wide
  /// metric be inserted again every run instead of being overwritten. The
  /// sentinel is what makes the snapshot idempotent.
  ///
  /// Deliberately not a foreign key either: a snapshot records what was true
  /// then, so a department deleted later must not take its own history with it,
  /// and a RESTRICT reference would make deleting one impossible once measured.
  scopeId   String   @default("")
  sampledOn DateTime @db.Date
  metric    String
  value     Float
  createdAt DateTime @default(now())

  /// One row per scope per metric per day — what makes a rerun overwrite
  /// rather than double-count.
  @@unique([scopeType, scopeId, sampledOn, metric])
  @@index([scopeType, scopeId, metric, sampledOn])
  @@index([metric, sampledOn])
  @@map("metric_snapshots")
}

/// Metadata for the document library. Files live in OpenProject; kind and
/// share state are EPM concerns.
model DocumentMeta {
  openProjectId String   @id
  kind          String
  shared        Boolean  @default(false)
  projectId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@map("document_meta")
}

/// Backs IntegrationStatus.lastSyncAt and the per-resource counts.
model SyncRun {
  id          String    @id @default(cuid())
  resource    String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  recordCount Int?
  ok          Boolean   @default(false)
  error       String?

  @@index([resource, startedAt])
  @@map("sync_runs")
}

/// Server-side sessions. The browser only ever holds an opaque HTTP-only
/// cookie; no OpenProject credential is ever issued to a client.
model Session {
  id            String   @id
  openProjectId String
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  lastSeenAt    DateTime @default(now())
  userAgent     String?

  /// OAuth2 tokens for this user, encrypted at rest with SESSION_SECRET.
  /// The browser never receives either one — it holds only the session id.
  accessToken    String?
  refreshToken   String?
  /// When the access token expires and the refresh token must be used.
  tokenExpiresAt DateTime?

  @@index([openProjectId])
  @@index([expiresAt])
  @@map("sessions")
}

/// An EPM-owned organisational unit. Unlike every model above, this is not an
/// overlay on an OpenProject record — departments exist only in EPM, so this
/// table owns its own identity rather than borrowing an upstream id.
model Department {
  id          String   @id @default(cuid())
  /// Unique regardless of case, enforced by a functional index on LOWER(name)
  /// in migration 20260903120000. Prisma's schema cannot express an index on an
  /// expression, so `@unique` is deliberately absent here — declaring it would
  /// recreate the plain index that the migration replaces.
  name        String
  code        String   @unique
  description String?
  /// OpenProject user id of the manager. Deliberately not a relation:
  /// OpenProject owns users, and a foreign key would mean copying them here.
  /// Display names resolve through the cached user directory at read time.
  managerId   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams        Team[]
  placeholders PlaceholderPerson[]
  members      UserProfile[]

  /// The list route filters on this by default.
  @@index([active])
  @@map("departments")
}

/// An EPM-owned delivery team.
///
/// Replaces the earlier reading of OpenProject groups as teams: a group could
/// not carry a department, a lifecycle or a code, and none existed on the
/// instance anyway. Membership, projects and capacity are deliberately absent —
/// each belongs to a later feature, and a column added now would be a guess at
/// its shape.
model Team {
  id           String      @id @default(cuid())
  /// Unique regardless of case, enforced by a functional index on LOWER(name).
  /// `@unique` is deliberately absent: Prisma cannot express an index on an
  /// expression, and declaring it here would add a redundant plain index.
  name         String
  code         String      @unique
  description  String?
  /// Nullable: a team may exist before the org chart does, or span departments.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  /// OpenProject user id of the lead. Not a relation, for the same reason a
  /// department's manager is not one — OpenProject owns users.
  leadId       String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  members      UserProfile[]
  placeholders PlaceholderPerson[]

  @@index([departmentId])
  @@index([active])
  @@map("teams")
}

/// Permissions EPM owns, which OpenProject has no concept of.
///
/// `departments:manage` is the first: it is listed in UNMAPPED precisely because
/// no upstream capability implies it. OpenProject remains the only source for
/// everything it does know about; this table is consulted only for permissions
/// it cannot answer, and is merged into the global permission set.
model EpmPermissionGrant {
  /// The OpenProject user id the grant belongs to.
  openProjectId String
  /// A value from the EPM `Permission` union, validated before writing.
  permission    String
  grantedAt     DateTime @default(now())
  /// Who granted it, where that is known. Null for environment bootstrap.
  grantedBy     String?

  @@id([openProjectId, permission])
  @@map("epm_permission_grants")
}

/// A named grouping of projects. EPM-owned: OpenProject has no concept of one,
/// and nothing here copies a project — the association is a single nullable
/// reference on the project's EPM profile.
///
/// A portfolio holds projects only. The teams working on a portfolio are
/// derived from its projects' members rather than declared here, so they cannot
/// drift from who is actually on the work.
model Portfolio {
  id          String   @id @default(cuid())
  /// Unique regardless of case, enforced by a functional index on LOWER(name).
  /// `@unique` is deliberately absent: Prisma cannot express an index on an
  /// expression, and declaring it here would add a redundant plain index.
  name        String
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects ProjectProfile[]

  /// The list route filters on this by default.
  @@index([active])
  @@map("portfolios")
}

/// A message for one person about something they should know and would not
/// otherwise see.
///
/// EPM-owned, and additive rather than duplicate: OpenProject notifications are
/// still read through from upstream and merged with these. Its notifications
/// cannot hold EPM events — a health transition or a capacity change is not an
/// OpenProject concept — so they needed a home, and this is it.
model Notification {
  id          String    @id @default(cuid())
  /// The OpenProject user id this is for. Not a foreign key: OpenProject owns
  /// users, as everywhere else in EPM.
  recipientId String
  /// From the existing NotificationCategory vocabulary. EPM events are `system`.
  category    String
  title       String
  body        String
  /// An EPM route to open. Never an OpenProject URL.
  link        String?
  severity    String    @default("info")
  /// What happened, at the granularity where repeating it is not news. Unique
  /// per recipient, so deduplication is a database guarantee rather than a
  /// check that could race two writers.
  dedupeKey   String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

/// A person's own settings, in the shape the Settings page renders. One row
/// per person; absent means the defaults. Kept as JSON because every key is a
/// switch the UI owns and the only server-side reader is the email worker.
model UserPreference {
  openProjectId String   @id
  data          Json
  updatedAt     DateTime @updatedAt

  @@map("user_preferences")
}

/// Every email EPM intends to send, before and after it is sent.
///
/// Writing here is cheap and always succeeds; a worker sends in batches with
/// retries. A request never waits on the mail provider, and the table is the
/// audit trail of what went to whom and why.
model EmailOutbox {
  id           String    @id @default(cuid())
  /// OpenProject user id of the recipient. Not a foreign key: OpenProject owns users.
  recipientId  String
  toEmail      String
  /// Template name, e.g. `invite`, `task-assigned`, `digest`.
  template     String
  subject      String
  /// The template's input, so a failed send can be retried or inspected.
  payload      Json
  /// `queued` → `sending` → `sent` | `failed`; `cancelled` when a preference
  /// changed or a digest absorbed it before it went out.
  status       String    @default("queued")
  /// `immediate` goes at the next tick; `digest` waits for the daily run.
  channel      String    @default("immediate")
  attempts     Int       @default(0)
  lastError    String?
  /// The provider's own message id, for tracing a complaint back to a row.
  providerId   String?
  /// Prevents the same event mailing the same person twice.
  dedupeKey    String?
  scheduledFor DateTime  @default(now())
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([recipientId, dedupeKey])
  @@index([status, scheduledFor])
  @@index([recipientId, channel, status])
  @@map("email_outbox")
}

/// One-time invitation. Only a hash of the token is stored; the link in the
/// email is the only copy of the token itself.
model InviteToken {
  id            String    @id @default(cuid())
  openProjectId String
  tokenHash     String    @unique
  email         String
  createdBy     String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([openProjectId])
  @@map("invite_tokens")
}

/// Pragnya conversations. Owned by the person who asked; nobody else reads them.
model AssistantConversation {
  id        String             @id @default(cuid())
  userId    String
  title     String
  messages  AssistantMessage[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  /// The tool calls the assistant made to answer, for the "how do you know" chips.
  toolCalls      Json?
  /// Token accounting per message, so cost is visible per person and per day.
  promptTokens   Int                   @default(0)
  outputTokens   Int                   @default(0)
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

/// -------------------------------------------------------------------------
/// Collaboration
/// -------------------------------------------------------------------------
///
/// Meetings, news and wiki pages. All three exist in OpenProject and none of
/// them is reachable: its meetings, news and wiki modules are HTML controllers
/// with no API v3 resource behind them, so there is nothing to read, nothing to
/// write, and no id to overlay. That makes these EPM's own records outright —
/// the only tables here that own their content rather than annotating something
/// upstream.
///
/// `projectId` is an OpenProject project id, or null for an organisation-wide
/// record. Deliberately not a foreign key, for the same reason nothing else
/// here is: OpenProject owns projects, and copying them in to satisfy a
/// constraint would make this database a second, staler directory of them.

/// A scheduled meeting, with its agenda and, afterwards, its minutes.
model Meeting {
  id              String   @id @default(cuid())
  title           String
  /// Null for an organisation-wide meeting.
  projectId       String?
  location        String?
  /// Start instant. A meeting happens at a moment, unlike a work package, which
  /// falls on a day — so this is a timestamp rather than a date.
  startsAt        DateTime
  /// Length in minutes, not an end instant: a meeting is scheduled as "Tuesday
  /// at ten for an hour", and storing the end would make the duration derived
  /// from two values that can be edited apart.
  durationMinutes Int      @default(60)
  /// Markdown. The agenda is written before, the minutes after; both are on the
  /// meeting rather than in separate records because neither is useful alone.
  agenda          String?
  minutes         String?
  /// planned | held | cancelled. A string rather than an enum, matching how
  /// every other status in this database is stored — a new state must not need a
  /// migration.
  state           String   @default("planned")
  /// OpenProject user id of whoever scheduled it.
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants MeetingParticipant[]

  @@index([projectId])
  @@index([startsAt])
  @@map("meetings")
}

/// Somebody invited to a meeting, and whether they turned up.
model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  /// OpenProject user id. Names resolve through the cached directory at read time.
  userId    String
  /// Invited and attended are independent: somebody can attend without being
  /// invited, and the minutes have to be able to say so.
  invited   Boolean @default(true)
  attended  Boolean @default(false)

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

/// An announcement, for a project or for the organisation.
model NewsPost {
  id          String    @id @default(cuid())
  title       String
  /// One-line standfirst shown in the list. Optional: a short post is its own summary.
  summary     String?
  /// Markdown.
  body        String
  projectId   String?
  authorId    String
  /// Null while it is a draft. Publishing is what makes it visible to anybody
  /// but its author, so this is the state rather than a separate flag.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([publishedAt])
  @@map("news_posts")
}

/// A wiki page, in a tree, with every past version kept.
model WikiPage {
  id        String     @id @default(cuid())
  /// URL-safe, and unique within its project — enforced by two partial indexes
  /// in the migration, because Postgres treats NULLs as distinct and a plain
  /// unique on (projectId, slug) would therefore not constrain the
  /// organisation-wide pages at all.
  slug      String
  title     String
  /// Markdown.
  body      String
  projectId String?
  /// Parent page, for the navigation tree. Cleared rather than cascaded when a
  /// parent is deleted: losing a section should not silently delete everything
  /// written under it.
  parentId  String?
  parent    WikiPage?  @relation("WikiTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  WikiPage[] @relation("WikiTree")
  /// Who saved the current version.
  updatedBy String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  revisions WikiRevision[]

  @@index([projectId])
  @@index([parentId])
  @@map("wiki_pages")
}

/// One saved version of a wiki page.
///
/// Written before each edit, holding what the page said *before* it — so the
/// newest revision is the previous version and the page itself is current. That
/// is what makes "restore" a plain copy rather than an arithmetic replay.
model WikiRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// Who made the edit that produced this snapshot of the previous text.
  authorId  String
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
  @@map("wiki_revisions")
}

/// -------------------------------------------------------------------------
/// Governance: the activity journal and project health (RAG)
/// -------------------------------------------------------------------------

/// The activity journal for EPM-owned data (BRL-02, NFR07).
///
/// OpenProject journals its own records under the user's token; nothing
/// journalled what EPM owns. This is that journal: one row per change, naming
/// who made it, what it was and, where the action requires one, why.
///
/// Append-only, and enforced below the application: the migration installs a
/// trigger that refuses UPDATE, DELETE and TRUNCATE on this table, so no route,
/// script or mistaken query can rewrite history. There is deliberately no
/// write path here other than inserting.
model AuditEvent {
  id         String   @id @default(cuid())
  /// Position in the journal. Timestamps can tie; this cannot, so "in
  /// sequence" means something.
  seq        Int      @unique @default(autoincrement())
  occurredAt DateTime @default(now())
  /// OpenProject user id of whoever caused it. Null when EPM itself did — a
  /// scheduled recalculation, say — which `actorKind` then says.
  actorId    String?
  /// `user` or `system`.
  actorKind  String
  /// The project the event belongs to, for a project's own journal. Null for
  /// instance-wide events such as a change to the health rules.
  projectId  String?
  /// What changed: `project`, `health-rules`, ...
  entityType String
  entityId   String
  /// A dotted verb: `health.calculated`, `health.override.set`, ...
  action     String
  /// One readable sentence, written when the event is recorded.
  summary    String
  /// The justification, where the action demands one.
  reason     String?
  before     Json?
  after      Json?
  /// Anything else worth keeping: what triggered it, the rule version.
  metadata   Json?

  @@index([projectId, seq])
  @@index([entityType, entityId, seq])
  @@index([action, occurredAt])
  @@map("audit_events")
}

/// The rules that compute project health (BR-204).
///
/// Versioned rather than edited: every save inserts a row and the highest
/// version is in force, so any stored calculation can name exactly the rules
/// it used. With no row at all, the defaults in `domain/health-rules.ts` apply
/// as version 0.
model HealthRuleSet {
  id        String   @id @default(cuid())
  version   Int      @unique
  /// Criteria, thresholds, weights and the overall rule. Validated on the way
  /// in and on the way out — see `domain/health-rules.ts`.
  rules     Json
  createdBy String
  createdAt DateTime @default(now())

  @@map("health_rule_sets")
}

/// The last calculated health of each project (BR-205).
///
/// Stored so health is one authoritative value per project rather than
/// whatever each viewer's request happened to compute, and so a change can be
/// noticed and journalled at all. Overwritten on every recalculation; the
/// history of what it was lives in `AuditEvent`.
model ProjectHealthState {
  /// OpenProject project id. Not a foreign key, as everywhere else here.
  projectId    String   @id
  /// The calculated levels, one per criterion plus overall.
  levels       Json
  /// The per-criterion results: figure, unit, level, reason, thresholds.
  criteria     Json
  explanation  String
  /// The figures the calculation used, so a value can be checked later.
  inputs       Json
  ruleVersion  Int
  /// What started the calculation: `change`, `sweep`, `rules`, `read`.
  trigger      String
  calculatedAt DateTime
  updatedAt    DateTime @updatedAt

  @@map("project_health_states")
}

/// A manual override of a project's calculated health that is in force
/// (BR-206).
///
/// One row per project at most: setting an override replaces it and clearing
/// one deletes it. That is safe because every set and clear is also written to
/// the journal with its reason — the journal is the history, and this table is
/// only the current answer.
model ProjectHealthOverride {
  projectId String   @id
  /// The pinned levels: `{ overall?, schedule?, budget?, risks?, overdue? }`.
  levels    Json
  /// Mandatory. A pin nobody can explain is the thing an auditor challenges.
  reason    String
  setBy     String
  setAt     DateTime @default(now())

  @@map("project_health_overrides")
}

/// -------------------------------------------------------------------------
/// Approvals (BRQ-09) and escalation events
/// -------------------------------------------------------------------------

/// Who must approve what, in which order (BR-211).
///
/// A chain applies to a kind of subject — today a work package of the chosen
/// types, in every project or the chosen ones — and lists its steps in order.
/// A step names its approvers and whether all of them or any one must agree,
/// and may apply only when a condition on the subject holds: a value over a
/// threshold, a type, a priority, a project or portfolio, a custom field.
///
/// Timesheets, expense claims and the external portal reuse the same engine
/// with their own subject types.
model ApprovalChain {
  id                String   @id @default(cuid())
  name              String
  description       String?
  /// `work_package` today.
  subjectType       String   @default("work_package")
  /// OpenProject type ids the chain covers. Empty means every type.
  typeIds           String[]
  /// OpenProject project ids the chain covers. Empty means every project.
  projectIds        String[]
  /// The custom field a value threshold is measured against, e.g. `customField3`.
  valueField        String?
  /// The steps, in order. Validated by `domain/approval-chains.ts`.
  steps             Json
  /// Statuses the subject is moved to on submission, approval and rejection.
  /// Optional; a chain can decide without touching the subject's status.
  onSubmitStatusId  String?
  onApproveStatusId String?
  onRejectStatusId  String?
  /// Off by default: the person who raised a change does not approve it.
  allowSelfApproval Boolean  @default(false)
  active            Boolean  @default(true)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  requests ApprovalRequest[]

  @@index([subjectType, active])
  @@map("approval_chains")
}

/// One subject going through a chain.
model ApprovalRequest {
  id               String        @id @default(cuid())
  chainId          String
  chain            ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Restrict)
  /// The chain as it was when this was submitted, with each step's condition
  /// already decided. A chain edited later does not change a request in flight.
  chainSnapshot    Json
  subjectType      String
  subjectId        String
  projectId        String
  /// What it is, for lists: the work package's key and subject.
  title            String
  /// The value at submission, from the chain's value field.
  value            Float?
  /// The subject's status before submission, put back if it is withdrawn.
  statusBefore     String?
  requestedBy      String
  requestedAt      DateTime      @default(now())
  /// pending | approved | rejected | cancelled
  status           String        @default("pending")
  /// Which step of the snapshot is deciding now.
  currentStep      Int           @default(0)
  completedAt      DateTime?
  /// Applying the outcome to the subject — moving its status — happens after
  /// the decision and can fail on its own; the decision stands either way.
  outcomeAppliedAt DateTime?
  outcomeError     String?

  tasks ApprovalTask[]

  @@index([subjectType, subjectId])
  @@index([projectId, status])
  @@index([requestedBy, status])
  @@map("approval_requests")
}

/// One approver's part in one step.
model ApprovalTask {
  id           String          @id @default(cuid())
  requestId    String
  request      ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepIndex    Int
  stepName     String
  /// The approver the chain named. Keeps the authority whatever is delegated.
  approverId   String
  /// Who may also decide, under a delegation active when the step started.
  delegateId   String?
  delegationId String?
  /// waiting (step not reached) | pending | approved | rejected | skipped
  status       String          @default("waiting")
  activatedAt  DateTime?
  dueAt        DateTime?
  breachedAt   DateTime?
  decidedAt    DateTime?
  /// Who actually decided: the approver, or their delegate.
  decidedBy    String?
  /// Set when a delegate decided: whose authority they used (BR-212).
  onBehalfOf   String?
  comment      String?

  @@index([requestId, stepIndex])
  @@index([approverId, status])
  @@index([delegateId, status])
  @@index([status, dueAt])
  @@map("approval_tasks")
}

/// A person's approvals handed to someone else for a period (BR-212).
///
/// Delegating adds authority and never removes it (BRL-06): the person who
/// delegated can still decide their own approvals throughout.
model ApprovalDelegation {
  id          String    @id @default(cuid())
  delegatorId String
  delegateId  String
  /// Inclusive, as calendar days.
  startsOn    DateTime  @db.Date
  endsOn      DateTime  @db.Date
  reason      String?
  createdBy   String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedBy   String?

  @@index([delegatorId, startsOn, endsOn])
  @@index([delegateId])
  @@map("approval_delegations")
}

/// The link in an approval email (BR-215).
///
/// Bound to one task and one person: it works only for that person, signed
/// in, and only once. Only a hash is stored; the token itself exists in the
/// email alone.
model ApprovalLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  taskId    String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([taskId])
  @@map("approval_link_tokens")
}

/// Something that needs a person's attention because nothing happened in time
/// (BR-214, and the rules engine after it).
///
/// Raised once per cause, enforced by `dedupeKey`, so a sweep that runs every
/// few minutes cannot raise the same breach twice.
model EscalationEvent {
  id          String    @id @default(cuid())
  /// What raised it: `approval.sla` for an approval step's own SLA, or
  /// `policy.untouched` | `policy.overdue` | `policy.approval_sla` for an
  /// escalation policy's levels.
  source      String
  subjectType String
  subjectId   String
  projectId   String?
  level       Int       @default(1)
  /// Who it is raised to.
  raisedFor   String[]
  reason      String
  dedupeKey   String    @unique
  raisedAt    DateTime  @default(now())
  /// When the condition stopped holding: touched, closed, rescheduled, decided.
  resolvedAt  DateTime?
  metadata    Json?
  /// The escalation policy that raised it, if one did.
  policyId    String?
  /// The policy's episode: one continuous stretch of the condition holding,
  /// named by when it began. A new stretch starts again at level one.
  episode     String?

  @@index([source, raisedAt])
  @@index([projectId, raisedAt])
  @@index([policyId, resolvedAt])
  @@map("escalation_events")
}

/// An automation rule (BR-216, BR-217): when a work package or project event
/// matches its conditions, its actions run as EPM's automation account.
model AutomationRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  /// `work_package` or `project`: what the rule watches and acts on.
  subjectType String   @default("work_package")
  /// The events it listens to, e.g. `work_package.created`, `work_package.updated`.
  events      String[]
  /// Projects it watches. Empty means every project.
  projectIds  String[]
  /// `{ match: 'all' | 'any', conditions: [...] }`. Validated by `domain/rules.ts`.
  conditions  Json
  /// `enter`: fires when an item starts to match, once until it stops.
  /// `every`: fires on every matching event.
  fireMode    String   @default("enter")
  /// The actions, in order. Validated by `domain/rules.ts`.
  actions     Json
  /// Bumped on every edit; a firing records the version it ran.
  version     Int      @default(1)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firings RuleFiring[]

  @@index([active, subjectType])
  @@map("automation_rules")
}

/// One event for the rules to consider: a change EPM made, or one OpenProject
/// reported by webhook. A queue in the database, so a second server claims
/// different events rather than the same ones twice.
model RuleEvent {
  id          String    @id @default(cuid())
  /// `epm` (a write through EPM), `webhook` (reported by OpenProject), or
  /// `automation` (a change a rule made, recorded only so its echo is ignored).
  source      String
  kind        String
  subjectType String
  subjectId   String
  projectId   String?
  /// The work package's lockVersion when known: with the id, one change.
  version     Int?
  actorId     String?
  /// `work_package:<id>:v<version>` when the version is known, so the same
  /// change reported by EPM and by the webhook is considered once.
  dedupeKey   String    @unique
  receivedAt  DateTime  @default(now())
  claimedAt   DateTime?
  claimedBy   String?
  processedAt DateTime?
  attempts    Int       @default(0)
  error       String?

  @@index([processedAt, receivedAt])
  @@map("rule_events")
}

/// Whether an item matched a rule when it was last considered, so an `enter`
/// rule fires as an item starts to match rather than on every change after.
model RuleItemState {
  ruleId      String
  subjectType String
  subjectId   String
  matched     Boolean
  /// The rule version this was decided under; an edited rule starts afresh.
  ruleVersion Int
  updatedAt   DateTime @updatedAt

  @@id([ruleId, subjectType, subjectId])
  @@map("rule_item_states")
}

/// Every time a rule fired, and what each of its actions did (BR-219).
model RuleFiring {
  id           String         @id @default(cuid())
  ruleId       String
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleVersion  Int
  ruleName     String
  eventId      String?
  /// The event kind that fired it.
  trigger      String
  subjectType  String
  subjectId    String
  /// What it was, for the log: `PROJ-12 Fix the export`.
  subjectTitle String?
  projectId    String?
  /// `succeeded` | `partial` | `failed`
  outcome      String
  /// `[{ type, outcome: 'done' | 'failed' | 'skipped', summary, error? }]`
  actions      Json
  firedAt      DateTime       @default(now())
  durationMs   Int?

  @@index([ruleId, firedAt])
  @@index([projectId, firedAt])
  @@index([subjectType, subjectId])
  @@map("rule_firings")
}

/// An escalation policy (BR-218): when an item is untouched, overdue or past an
/// approval step's SLA for long enough, its levels tell the next people on the
/// path, one level at a time.
model EscalationPolicy {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  /// `untouched` | `overdue` | `approval_sla`
  trigger     String
  /// Empty means every project, type or priority.
  projectIds  String[]
  typeIds     String[]
  priorityIds String[]
  /// `[{ after, notify: [...] }]` in order: `after` is days for untouched and
  /// overdue, hours past the SLA for approvals. Validated by `domain/escalation.ts`.
  levels      Json
  version     Int      @default(1)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, trigger])
  @@map("escalation_policies")
}

/// Who runs a scheduled job right now. A lease rather than a lock, so a server
/// that dies mid-run releases it by expiry instead of holding it forever.
model JobLease {
  name      String   @id
  holder    String
  expiresAt DateTime

  @@map("job_leases")
}
