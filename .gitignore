# Secrets — the OpenProject API key lives here and must never be committed.
.env
.env.*
!.env.example
# The production template, which holds no secret and is the thing a deployment
# host is told to copy. Without this negation `.env.*` above swallows it and it
# never reaches the repository at all.
!.env.prod.example
backend/.env
backend/.env.*
!backend/.env.example
backend/SECURITY.md

# Frontend env files are non-secret (VITE_* is bundled into the client) and stay tracked.
# `.env.production` especially: Vite inlines it at build time, so a build host
# that cannot see it silently falls back to the localhost values in `.env`.
!frontend/.env
!frontend/.env.production
!frontend/.env.example

node_modules/
dist/
build/
coverage/
*.tsbuildinfo


# Prisma
prisma/*.db
prisma/*.db-journal

.DS_Store
*.log
npm-debug.log*
.idea/
.vscode/

# Output of `npm run probe` — instance configuration, not secret but not useful in git.
backend/openproject-profile.json

# Local UI screenshot captures
.shots/

# Working material: design notes, the acceptance suite and its report, the plan,
# the user guide. Kept out of the repository for now.
#
# `docs/` is already tracked, so this rule alone does not untrack it — ignoring a
# path git already follows changes nothing. That needs `git rm --cached -r docs`,
# which unstages it without deleting your copy. The others have never been
# committed, so the rule is enough on its own.
#
# `e2e/` holds the Playwright suite itself, not just its output, so nothing here
# runs in CI while it is ignored.
docs/
e2e/
report/
project-plan/
user-guide/

# Archives, including the docs.zip and e2e.zip in the root. e2e.zip alone is
# 11 MB, and a repository is the wrong place for a snapshot of a directory it
# already ignores.
*.zip

# Private keys. Never in the repository.
*.ppk
*.pem

# HyperFrames video projects — captures and renders are hundreds of MB.
videos/
