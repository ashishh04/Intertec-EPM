# Base URL of the EPM Backend / BFF (never the OpenProject instance directly)
VITE_API_BASE_URL=http://localhost:8000/api

# Environment banner shown in the top header: development | staging | production
VITE_APP_ENV=development

# ISO 4217 code for the currency internal hourly rates are quoted in. Labels the
# rate field on the staffing dialog only; every computed figure carries the
# currency the backend reports. Keep it equal to EPM_CURRENCY on the backend.
VITE_CURRENCY=AED
