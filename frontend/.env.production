# Read by `vite build`, which inlines these into the bundle — they are compile
# time values, not runtime ones, so changing them means rebuilding.
#
# The committed `.env` points at localhost for development. Without this file
# a production build inherits that, and every browser then calls its own
# machine on port 8000: the app is wholly broken and the backend logs stay
# silent, because nothing ever reaches it.
#
# Set this to the address the BACKEND is served from, not the frontend.
VITE_API_BASE_URL=https://epm-api.example.com/api

# Drives `isProduction` in config/env.ts, which hides the environment banner.
VITE_APP_ENV=production
