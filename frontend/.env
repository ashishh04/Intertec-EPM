# Base URL of the Nexus Backend / BFF (never the OpenProject instance directly)
VITE_API_BASE_URL=http://localhost:8000/api

# Data source: "mock" uses the bundled demo repositories, "api" calls the Nexus backend
VITE_DATA_SOURCE=mock

# Environment banner shown in the top header: demo | development | staging | production
VITE_APP_ENV=demo
