# Caddy fronts the whole deployment.
#
# TLS is not optional here. The backend sets `secure` on the session cookie
# whenever NODE_ENV is production, and a secure cookie is never sent over plain
# HTTP — so on http:// the browser accepts the sign-in response, silently drops
# the cookie, and bounces the person straight back to the login form with
# nothing in any log to explain it. Caddy obtains and renews a certificate on
# its own, provided EPM_DOMAIN resolves to this host.

{$EPM_DOMAIN} {
	encode zstd gzip

	# The API, proxied under the same origin as the app.
	#
	# Same-origin is what keeps the session cookie simple: no CORS preflight on
	# every request, and `SameSite=lax` behaves as intended because the browser
	# is not crossing a site boundary. The backend's own CORS allowlist still
	# applies and should name this domain.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Readiness, so a load balancer or uptime check can reach it without the
	# API prefix. `/health` is liveness only and deliberately checks nothing.
	handle /ready {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	# Everything else is the single-page app. `try_files` sends unknown paths to
	# index.html so a deep link like /projects/42/board is resolved by the
	# router rather than answered with a 404 by the file server.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		# HSTS. Only meaningful once TLS is working, which it is by the time a
		# response reaches here.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The app's own pages: everything that is not the API or a hashed asset.
	#
	# Content-Security-Policy (BRL-01, BR-608). The bundle loads nothing from
	# any other origin — fonts are bundled, the API is this origin's /api, and
	# there are no inline scripts, eval, workers or frames — so every source is
	# 'self'. Two allowances, both deliberate:
	#   style-src 'unsafe-inline'   sonner and Radix inject <style> elements at
	#                               run time. Styles cannot run code; scripts
	#                               stay strictly 'self'.
	#   img-src / font-src data:    a CSS noise texture, and small font subsets
	#                               Vite inlines into the stylesheet.
	# With script-src 'self' a `javascript:` link cannot run, whatever text ends
	# up in a task, a wiki page or an assistant answer.
	#
	# The API sets its own, stricter policy (the backend's helmet settings), so
	# this one is not applied to it.
	#
	# Cache-Control: index.html is served for `/` and for every deep link, not
	# only for /index.html, so it is matched by exclusion. `no-cache` lets the
	# browser keep it but makes it check with the server every time (a cheap
	# ETag round trip); without it, a browser can hold the previous index.html
	# after a deploy and ask for asset files the new image no longer has.
	@document not path /api/* /ready /health /assets/*
	header @document {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cache-Control "no-cache"
	}

	# Hashed asset filenames are immutable.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
