# Production environment for the EPM stack.
#
#   cp .env.prod.example .env.prod   then fill it in, then:
#   docker compose -f docker-compose.deploy.yml --env-file .env.prod pull
#   docker compose -f docker-compose.deploy.yml --env-file .env.prod up -d
#
# Copy it to `.env.prod`, which is gitignored. This file is the template and
# must never hold a real secret.
#
# --- Which images to run ---------------------------------------------------
# Your Docker Hub account name, which is the namespace the release workflow
# publishes under. The three images are <namespace>/epm-backend,
# <namespace>/epm-web and <namespace>/epm-openproject.
EPM_IMAGE_NAMESPACE=

# The release to run. A version, not `latest`: with a version, `docker ps` tells
# you what is deployed and a rollback is editing one line. With `latest` both
# become guesswork, and the tag you rolled back from is gone.
EPM_IMAGE_TAG=1.0.0

# The hostname people open EPM at. Must already resolve to this machine before
# the first `up`, or Caddy cannot obtain a certificate — and without TLS the
# session cookie is dropped and nobody can sign in.
EPM_DOMAIN=epm.example.com

# --- Secrets. Generate, do not invent. -----------------------------------
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 64
OPENPROJECT_SECRET_KEY_BASE=
# openssl rand -base64 24
POSTGRES_PASSWORD=

POSTGRES_USER=epm
POSTGRES_DB=epm

# --- OpenProject ----------------------------------------------------------
# Taken from the running instance once it is up: sign in as an administrator →
# My account → Access tokens → API. See the deployment notes.
OPENPROJECT_API_KEY=

# Administration → Authentication → OAuth applications. Needed for sign-in:
# EPM exchanges a person's credentials for a token on their behalf.
OPENPROJECT_OAUTH_CLIENT_ID=
OPENPROJECT_OAUTH_CLIENT_SECRET=

# Administration → API and webhooks → Webhooks. Optional; without it EPM still
# works, it just learns about upstream changes on its own schedule.
OPENPROJECT_WEBHOOK_SECRET=

# --- Where OpenProject keeps its data ------------------------------------
# The instance database and every attachment. Point this at a mounted EBS
# volume so it can be snapshotted independently of the instance.
OPENPROJECT_DATA_DIR=/srv/openproject

# --- Mail -----------------------------------------------------------------
# SMTP wins when host, user and password are all set; otherwise Resend; with
# neither, email is logged rather than sent.
#
# A Gmail App Password works and needs no verified domain, but caps around 500
# messages a day and sends from a gmail.com address, which is more likely to be
# filtered. A verified domain is the better answer for anything beyond a beta.
EMAIL_FROM=EPM <epm@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# The outbox worker. Off unless asked: a process that sends mail should have to
# be told to.
EPM_EMAIL_WORKER_ENABLED=true
