# Production environment for the EPM stack.
#
#   cp .env.prod.example .env.prod   then fill it in, then:
#   docker compose -f docker-compose.deploy.yml --env-file .env.prod pull
#   docker compose -f docker-compose.deploy.yml --env-file .env.prod up -d
#
# Copy it to `.env.prod`, which is gitignored. This file is the template and
# must never hold a real secret.
#
# --- Which images to run ---------------------------------------------------
# Your Docker Hub account name, which is the namespace the release workflow
# publishes under. The three images are <namespace>/epm-backend,
# <namespace>/epm-web and <namespace>/epm-openproject.
EPM_IMAGE_NAMESPACE=

# The release to run. A version, not `latest`: with a version, `docker ps` tells
# you what is deployed and a rollback is editing one line. With `latest` both
# become guesswork, and the tag you rolled back from is gone.
EPM_IMAGE_TAG=1.0.0

# The hostname people open EPM at. Must already resolve to this machine before
# the first `up`, or Caddy cannot obtain a certificate — and without TLS the
# session cookie is dropped and nobody can sign in.
EPM_DOMAIN=epm.example.com

# --- Secrets. Generate, do not invent. -----------------------------------
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 64
OPENPROJECT_SECRET_KEY_BASE=
# openssl rand -base64 24
POSTGRES_PASSWORD=

POSTGRES_USER=epm
POSTGRES_DB=epm

# --- OpenProject ----------------------------------------------------------
# Taken from the running instance once it is up: sign in as an administrator →
# My account → Access tokens → API. See the deployment notes.
OPENPROJECT_API_KEY=

# Administration → Authentication → OAuth applications. Needed for sign-in:
# EPM exchanges a person's credentials for a token on their behalf.
OPENPROJECT_OAUTH_CLIENT_ID=
OPENPROJECT_OAUTH_CLIENT_SECRET=

# Administration → API and webhooks → Webhooks. Optional; without it EPM still
# works, it just learns about upstream changes on its own schedule.
OPENPROJECT_WEBHOOK_SECRET=

# --- Who administers EPM --------------------------------------------------
# Comma-separated OpenProject user ids that hold EPM's own administrative
# permissions. Being an OpenProject administrator does not imply them: they
# cover things OpenProject has no concept of, like health overrides and
# portfolios.
#
# This is not optional on a new database. The grants table starts empty and
# nothing in the UI writes the first row, so an unset value means nobody can
# administer the deployment and there is no way in from the outside.
EPM_ADMIN_USER_IDS=

# --- Where OpenProject keeps its data ------------------------------------
# The instance database and every attachment. Point this at a mounted EBS
# volume so it can be snapshotted independently of the instance.
OPENPROJECT_DATA_DIR=/srv/openproject

# --- Mail -----------------------------------------------------------------
# SMTP wins when host, user and password are all set; otherwise Resend; with
# neither, email is logged rather than sent.
#
# A Gmail App Password works and needs no verified domain, but caps around 500
# messages a day and sends from a gmail.com address, which is more likely to be
# filtered. A verified domain is the better answer for anything beyond a beta.
EMAIL_FROM=EPM <epm@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Implicit TLS. Left empty it follows the port — 465 implicit, 587 STARTTLS —
# which is correct for almost every provider. Set `true` or `false` only to
# override that.
SMTP_SECURE=
RESEND_API_KEY=

# The outbox worker. Off unless asked: a process that sends mail should have to
# be told to.
EPM_EMAIL_WORKER_ENABLED=true

# Hour, UTC, that the daily digest goes out.
EPM_EMAIL_DIGEST_HOUR_UTC=6

# The daily deadline reminder, which emails people about work that is due. Off
# here deliberately — turn it on once mail is pointed somewhere real and you
# have seen what the digest looks like.
EPM_DUE_REMINDER_ENABLED=false
EPM_DUE_REMINDER_HOUR_UTC=7
EPM_DUE_REMINDER_DAYS=3

# --- Analytics ------------------------------------------------------------
# Periodic snapshots, which are what the trend charts read. On by default in a
# deployment and off everywhere else, because the history can only be built
# forwards: a month with the scheduler off is a month of trends that cannot be
# recovered afterwards.
EPM_ANALYTICS_SNAPSHOT_ENABLED=true
EPM_ANALYTICS_SNAPSHOT_INTERVAL_MINUTES=1440

# --- Project health ---------------------------------------------------------
# Health is recalculated whenever EPM sees a change, and on this sweep, which
# catches the changes it does not see: time logged or dates moved directly in
# the delivery system with no webhook configured, and work that became overdue
# overnight. On unless set to "false". It sends nothing itself; a project's
# owner is told only when its health actually moves.
EPM_HEALTH_SWEEP_ENABLED=true
EPM_HEALTH_SWEEP_INTERVAL_MINUTES=60

# --- Approvals ----------------------------------------------------------------
# Escalates approval steps that outlive their SLA and keeps delegations current.
# On unless set to "false"; every 5 minutes by default.
EPM_APPROVAL_SWEEP_ENABLED=true
EPM_APPROVAL_SWEEP_INTERVAL_MINUTES=5

# --- Rules and escalation ----------------------------------------------------------
# The automation account rules act as: a non-administrator OpenProject user that
# backend/openproject/setup/automation-account.rb creates and whose key it prints
# once (see DEPLOY.md). Without it rules notify and call out but change nothing in
# OpenProject. Any secret below may come from a file instead, e.g.
# OPENPROJECT_AUTOMATION_API_KEY_FILE=/run/secrets/epm_automation_key.
OPENPROJECT_AUTOMATION_API_KEY=
# The rule worker and the escalation sweep. On unless set to "false".
EPM_RULES_ENABLED=true
EPM_RULES_POLL_SECONDS=5
EPM_ESCALATION_SWEEP_ENABLED=true
EPM_ESCALATION_SWEEP_INTERVAL_MINUTES=15
# Hosts a rule's outbound call may reach although private or plain http,
# comma-separated. Empty: public https endpoints only.
EPM_RULES_OUTBOUND_ALLOWLIST=
# Signs every outbound rule call: X-EPM-Signature: sha256=<HMAC-SHA256 of the body>.
EPM_RULES_WEBHOOK_SECRET=

# --- Analytics model and replica (reports, dashboards, BI) -------------------------
# The model every dashboard reads: refreshed soon after each change and every few
# minutes, in full nightly at this hour (UTC), expected to finish within the window.
EPM_ANALYTICS_MODEL_ENABLED=true
EPM_ANALYTICS_FULL_REFRESH_HOUR_UTC=1
EPM_ANALYTICS_REFRESH_WINDOW_MINUTES=30
# The response target each dashboard is measured against.
EPM_DASHBOARD_TARGET_MS=2000
# The analytics replica, started with `--profile analytics` (DEPLOY.md, "Analytics
# replica"). The replication account streams with the first password; BI tools and
# EPM's access check sign in as the read-only analytics role with the second.
EPM_REPLICATION_PASSWORD=
EPM_ANALYTICS_DB_PASSWORD=
# Where BI tools connect from, and the interface the replica listens on. Loopback by
# default: reach it over an SSH tunnel, or name the analytics estate's range here.
EPM_ANALYTICS_ALLOWED_CIDR=samenet
EPM_ANALYTICS_BIND=127.0.0.1
EPM_ANALYTICS_PORT=5434
# For the access check in Administration: the analytics role on the replica.
EPM_ANALYTICS_DATABASE_URL=postgresql://epm_analytics:<EPM_ANALYTICS_DB_PASSWORD>@postgres-replica:5432/epm

# --- Scheduled reports and operations alerts -------------------------------------
# How often due reports are looked for, how long each run is logged (the records
# policy: seven years) and how long the files it sent are kept.
EPM_REPORT_SCHEDULER_ENABLED=true
EPM_REPORT_SCHEDULER_SECONDS=60
EPM_REPORT_RUN_RETENTION_DAYS=2555
EPM_REPORT_ARTIFACT_RETENTION_DAYS=90
# Who is told when an email still fails after its retries: OpenProject user ids,
# comma-separated; the administrators when empty. And, if set, an endpoint that
# receives each alert as JSON — monitoring that does not depend on the mail relay.
EPM_OPS_ALERT_USER_IDS=
EPM_OPS_ALERT_WEBHOOK_URL=

# --- Critical path ------------------------------------------------------------------
# Recalculated after each change EPM makes, and whenever the check finds OpenProject's
# network moved. A read waits for a pending pass up to this many work packages; above
# it, it answers at once. The mirror needs setup/schedule-fields.rb run once (DEPLOY.md).
EPM_SCHEDULE_ENABLED=true
EPM_SCHEDULE_CHECK_SECONDS=60
EPM_SCHEDULE_SYNC_LIMIT=500
EPM_SCHEDULE_NEAR_CRITICAL_DAYS=2
EPM_SCHEDULE_MIRROR_ENABLED=true
EPM_SCHEDULE_RUN_RETENTION_DAYS=30

# --- The assistant --------------------------------------------------------
# Bedrock. Leave all four empty and the assistant reports itself unavailable
# rather than erroring, so this is the one block that is genuinely optional.
# BEDROCK_MODEL_ID carries the provider prefix, e.g. anthropic.claude-sonnet-5.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=

# info, debug, warn or error.
LOG_LEVEL=info
